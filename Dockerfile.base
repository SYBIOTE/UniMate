# UniMate shared base image -- CUDA + PyTorch + serving deps. No weights.
#
# Weights live outside the image, as for Kimodo / HY-Motion: a mounted
# ./unimate-weights locally, the network volume (/runpod-volume/unimate) on
# RunPod. docker-entrypoint.sh (added by the thin images) resolves them;
# scripts/seed_weights.py fills a root once.
#
#   docker build -f Dockerfile.base -t sybiote/unimate-base:latest .
#   docker push sybiote/unimate-base:latest
#
# Ubuntu 22.04's system Python is 3.10, the version requirements-serve.txt is
# pinned and tested against.

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    HF_HUB_DISABLE_TELEMETRY=1 \
    MPLBACKEND=Agg

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-dev git ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

# The Motion git dependency has a legacy setup.py that imports pkg_resources,
# gone from setuptools >= 81, so it must build without isolation.
COPY requirements-serve.txt .
RUN python -m pip install --upgrade pip "setuptools<81" wheel \
 && python -m pip install --no-build-isolation -r requirements-serve.txt
