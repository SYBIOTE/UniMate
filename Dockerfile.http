# UniMate -- synchronous HTTP API (api.py) for direct testing.
#
# Weights are mounted, not baked (see docker-entrypoint.sh):
#   make build-base && make build && make weights && make dev

ARG BASE_IMAGE=docker.io/sybiote/unimate-base:latest
FROM ${BASE_IMAGE}

COPY requirements-api.txt .
RUN python -m pip install -r requirements-api.txt

COPY unimate/ unimate/
COPY data_process/ data_process/
COPY scripts/ scripts/
COPY api.py api.py
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
